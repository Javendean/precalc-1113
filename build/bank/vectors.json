{"kc": "vectors", "items": [{"id": "vectors-01", "kc": "vectors", "difficulty": 2, "est_seconds": 40, "stem": "Find the magnitude of $\\vec{v}=\\langle 3,-4\\rangle$.", "hint": "Magnitude comes from the Pythagorean theorem, not from adding components.", "worked": ["$\\|\\vec v\\|=\\sqrt{3^{2}+(-4)^{2}}=\\sqrt{25}$", "$=5$"], "options": [{"key": "a", "text": "$5$", "correct": true}, {"key": "b", "text": "$-1$", "correct": false, "mis": "LIN_SQRT_SUM"}, {"key": "c", "text": "$25$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$7$", "correct": false, "mis": null}], "source": "hand"}, {"id": "vectors-02", "kc": "vectors", "difficulty": 3, "est_seconds": 50, "stem": "If $\\vec{u}=\\langle 2,5\\rangle$ and $\\vec{v}=\\langle -1,3\\rangle$, find $\\vec{u}-\\vec{v}$.", "hint": "Subtract componentwise, and mind the sign of the first component of $\\vec v$.", "worked": ["$\\langle 2-(-1),\\ 5-3\\rangle$", "$=\\langle 3,2\\rangle$"], "options": [{"key": "a", "text": "$\\langle 3,2\\rangle$", "correct": true}, {"key": "b", "text": "$\\langle 1,8\\rangle$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "c", "text": "$\\langle -3,-2\\rangle$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$\\langle 2,15\\rangle$", "correct": false, "mis": null}], "source": "hand"}, {"id": "vectors-03", "kc": "vectors", "difficulty": 4, "est_seconds": 70, "stem": "A vector has magnitude $10$ and direction $60^\\circ$ from the positive $x$-axis. Find its component form.", "hint": "The horizontal component uses cosine.", "worked": ["$x=10\\cos 60^\\circ=10\\cdot\\dfrac{1}{2}=5$", "$y=10\\sin 60^\\circ=10\\cdot\\dfrac{\\sqrt{3}}{2}=5\\sqrt{3}$"], "options": [{"key": "a", "text": "$\\langle 5,5\\sqrt{3}\\rangle$", "correct": true}, {"key": "b", "text": "$\\langle 5\\sqrt{3},5\\rangle$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$\\langle 10,10\\rangle$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$\\langle 5,5\\rangle$", "correct": false, "mis": null}], "source": "hand"}]}