{"kc": "sequences_series", "items": [{"id": "sequences_series-01", "kc": "sequences_series", "difficulty": 3, "est_seconds": 50, "stem": "An arithmetic sequence has $a_{n}=3+4(n-1)$. Find $a_{10}$.", "hint": "Substitute $n=10$ and respect the $n-1$.", "worked": ["$a_{10}=3+4(10-1)$", "$=3+36=39$"], "options": [{"key": "a", "text": "$39$", "correct": true}, {"key": "b", "text": "$43$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$3\\cdot 4^{9}$", "correct": false, "mis": "SEQ_ARITH_GEOM_MIXUP"}, {"key": "d", "text": "$40$", "correct": false, "mis": null}], "source": "hand"}, {"id": "sequences_series-02", "kc": "sequences_series", "difficulty": 3, "est_seconds": 55, "stem": "A geometric sequence has first term $2$ and common ratio $3$. Find the fifth term.", "hint": "The first term already counts, so the ratio is applied one time fewer.", "worked": ["$a_{n}=a_{1}r^{n-1}$", "$a_{5}=2\\cdot 3^{4}=2\\cdot 81=162$"], "options": [{"key": "a", "text": "$162$", "correct": true}, {"key": "b", "text": "$14$", "correct": false, "mis": "SEQ_ARITH_GEOM_MIXUP"}, {"key": "c", "text": "$486$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$30$", "correct": false, "mis": null}], "source": "hand"}, {"id": "sequences_series-03", "kc": "sequences_series", "difficulty": 2, "est_seconds": 40, "stem": "Which of these sequences is geometric?", "hint": "Ask whether you ADD the same number each time or MULTIPLY by the same number.", "worked": ["$2,6,18,54$ multiplies by $3$ each time", "That is a common ratio, so it is geometric"], "options": [{"key": "a", "text": "$2,\\ 6,\\ 18,\\ 54$", "correct": true}, {"key": "b", "text": "$2,\\ 6,\\ 10,\\ 14$", "correct": false, "mis": "SEQ_ARITH_GEOM_MIXUP"}, {"key": "c", "text": "$5,\\ 10,\\ 15,\\ 20$", "correct": false, "mis": "SEQ_ARITH_GEOM_MIXUP"}, {"key": "d", "text": "$1,\\ 4,\\ 9,\\ 16$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}]}