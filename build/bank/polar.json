{"kc": "polar", "items": [{"id": "polar-01", "kc": "polar", "difficulty": 3, "est_seconds": 55, "stem": "Convert the polar point $\\left(4,\\dfrac{\\pi}{3}\\right)$ to rectangular coordinates.", "hint": "$x=r\\cos\\theta$ and $y=r\\sin\\theta$.", "worked": ["$x=4\\cos\\dfrac{\\pi}{3}=4\\cdot\\dfrac{1}{2}=2$", "$y=4\\sin\\dfrac{\\pi}{3}=4\\cdot\\dfrac{\\sqrt{3}}{2}=2\\sqrt{3}$"], "options": [{"key": "a", "text": "$(2,2\\sqrt{3})$", "correct": true}, {"key": "b", "text": "$(2\\sqrt{3},2)$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$(2,2)$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$\\left(4,\\dfrac{\\pi}{3}\\right)$", "correct": false, "mis": null}], "source": "hand"}, {"id": "polar-02", "kc": "polar", "difficulty": 5, "est_seconds": 90, "stem": "Convert $(-3,3)$ to polar form with $r>0$ and $0\\le\\theta<2\\pi$.", "hint": "The point is in Quadrant II, but a calculator's inverse tangent is not.", "worked": ["$r=\\sqrt{9+9}=3\\sqrt{2}$", "The reference angle is $\\dfrac{\\pi}{4}$", "Quadrant II gives $\\theta=\\pi-\\dfrac{\\pi}{4}=\\dfrac{3\\pi}{4}$"], "options": [{"key": "a", "text": "$\\left(3\\sqrt{2},\\dfrac{3\\pi}{4}\\right)$", "correct": true}, {"key": "b", "text": "$\\left(3\\sqrt{2},-\\dfrac{\\pi}{4}\\right)$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "c", "text": "$\\left(0,\\dfrac{3\\pi}{4}\\right)$", "correct": false, "mis": "LIN_SQRT_SUM"}, {"key": "d", "text": "$\\left(18,\\dfrac{3\\pi}{4}\\right)$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}, {"id": "polar-03", "kc": "polar", "difficulty": 2, "est_seconds": 40, "stem": "Which pair of conversion formulas is correct?", "hint": "Cosine goes with the horizontal direction.", "worked": ["$x=r\\cos\\theta$ and $y=r\\sin\\theta$"], "options": [{"key": "a", "text": "$x=r\\cos\\theta,\\ y=r\\sin\\theta$", "correct": true}, {"key": "b", "text": "$x=r\\sin\\theta,\\ y=r\\cos\\theta$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$r=x^{2}+y^{2}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$\\theta=\\arctan\\dfrac{x}{y}$", "correct": false, "mis": null}], "source": "hand"}]}