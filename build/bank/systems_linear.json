{"kc": "systems_linear", "items": [{"id": "systems_linear-01", "kc": "systems_linear", "difficulty": 2, "est_seconds": 55, "stem": "Solve the system $2x+y=7$ and $x-y=2$.", "hint": "Adding the two equations removes $y$ immediately.", "worked": ["Add: $3x=9$, so $x=3$", "Substitute back: $3-y=2$, so $y=1$"], "options": [{"key": "a", "text": "$(3,1)$", "correct": true}, {"key": "b", "text": "$x=3$", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "c", "text": "$(3,-1)$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "$(1,3)$", "correct": false, "mis": null}], "source": "hand"}, {"id": "systems_linear-02", "kc": "systems_linear", "difficulty": 3, "est_seconds": 60, "stem": "Solve the system $y=2x-1$ and $3x+y=9$.", "hint": "Substitute the first equation into the second, then finish BOTH variables.", "worked": ["$3x+(2x-1)=9$", "$5x=10$, so $x=2$", "$y=2(2)-1=3$"], "options": [{"key": "a", "text": "$(2,3)$", "correct": true}, {"key": "b", "text": "$x=2$", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "c", "text": "$(2,-3)$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "$(2,1)$", "correct": false, "mis": null}], "source": "hand"}, {"id": "systems_linear-03", "kc": "systems_linear", "difficulty": 3, "est_seconds": 45, "stem": "How many solutions can a system of two linear equations in two variables have?", "hint": "Think about two lines in a plane: crossing, parallel, or identical.", "worked": ["Crossing lines give one solution", "Parallel lines give none", "Identical lines give infinitely many"], "options": [{"key": "a", "text": "$0$, $1$, or infinitely many", "correct": true}, {"key": "b", "text": "exactly $1$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$0$ or $1$", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "d", "text": "$1$ or $2$", "correct": false, "mis": null}], "source": "hand"}]}