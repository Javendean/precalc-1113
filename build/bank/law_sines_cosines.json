{"kc": "law_sines_cosines", "items": [{"id": "law_sines_cosines-01", "kc": "law_sines_cosines", "difficulty": 2, "est_seconds": 40, "stem": "You know two sides of a triangle and the angle between them. Which law finds the third side?", "hint": "The law of sines needs an angle paired with the side opposite it.", "worked": ["With two sides and the included angle there is no angle-side pair", "So the law of cosines applies"], "options": [{"key": "a", "text": "the law of cosines", "correct": true}, {"key": "b", "text": "the law of sines", "correct": false, "mis": "TRIG_LAW_CHOICE"}, {"key": "c", "text": "the Pythagorean theorem", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "neither law applies", "correct": false, "mis": null}], "source": "hand"}, {"id": "law_sines_cosines-02", "kc": "law_sines_cosines", "difficulty": 4, "est_seconds": 90, "stem": "In a triangle, $a=5$, $b=8$, and the included angle $C=60^\\circ$. Find $c$.", "hint": "$c^{2}=a^{2}+b^{2}-2ab\\cos C$, and $\\cos 60^\\circ=\\dfrac{1}{2}$.", "worked": ["$c^{2}=25+64-2(5)(8)\\left(\\dfrac{1}{2}\\right)$", "$c^{2}=89-40=49$", "$c=7$"], "options": [{"key": "a", "text": "$7$", "correct": true}, {"key": "b", "text": "$\\sqrt{89}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$\\sqrt{129}$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "$13$", "correct": false, "mis": null}], "source": "hand"}, {"id": "law_sines_cosines-03", "kc": "law_sines_cosines", "difficulty": 3, "est_seconds": 50, "stem": "Which is the correct statement of the law of sines?", "hint": "Each side sits over the sine of the angle opposite it.", "worked": ["$\\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}=\\dfrac{c}{\\sin C}$"], "options": [{"key": "a", "text": "$\\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}$", "correct": true}, {"key": "b", "text": "$\\dfrac{\\sin A}{a}=\\dfrac{b}{\\sin B}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$\\dfrac{a}{\\cos A}=\\dfrac{b}{\\cos B}$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "d", "text": "$a^{2}=b^{2}+c^{2}$", "correct": false, "mis": "TRIG_LAW_CHOICE"}], "source": "hand"}, {"id": "law_sines_cosines-04", "kc": "law_sines_cosines", "difficulty": 4, "est_seconds": 55, "stem": "You are given two sides and an angle NOT between them. How many triangles can fit that data?", "hint": "This is the ambiguous case. Try to picture swinging the loose side.", "worked": ["The loose side may miss, just touch, or cross twice", "So there can be $0$, $1$ or $2$ triangles"], "options": [{"key": "a", "text": "$0$, $1$, or $2$", "correct": true}, {"key": "b", "text": "exactly $1$", "correct": false, "mis": "TRIG_LAW_CHOICE"}, {"key": "c", "text": "exactly $2$", "correct": false, "mis": null}, {"key": "d", "text": "$0$ or $1$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}, {"id": "law_sines_cosines-05", "kc": "law_sines_cosines", "difficulty": 5, "est_seconds": 95, "stem": "A triangle has sides $a=3$, $b=5$, $c=7$. Find the angle $C$ opposite the longest side.", "hint": "Solve the law of cosines for $\\cos C$ and keep the sign you get.", "worked": ["$\\cos C=\\dfrac{a^{2}+b^{2}-c^{2}}{2ab}=\\dfrac{9+25-49}{30}$", "$\\cos C=\\dfrac{-15}{30}=-\\dfrac{1}{2}$", "$C=120^\\circ$"], "options": [{"key": "a", "text": "$120^\\circ$", "correct": true}, {"key": "b", "text": "$60^\\circ$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "c", "text": "$90^\\circ$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$30^\\circ$", "correct": false, "mis": null}], "source": "hand"}]}