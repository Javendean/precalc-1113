{"kc": "trig_equations", "items": [{"id": "trig_equations-01", "kc": "trig_equations", "difficulty": 2, "est_seconds": 50, "stem": "Solve $\\sin x=\\dfrac{1}{2}$ on $[0,2\\pi)$.", "hint": "Sine is positive in two quadrants, so look for two answers.", "worked": ["Reference angle $\\dfrac{\\pi}{6}$", "Sine is positive in Quadrants I and II", "$x=\\dfrac{\\pi}{6}$ and $x=\\pi-\\dfrac{\\pi}{6}=\\dfrac{5\\pi}{6}$"], "options": [{"key": "a", "text": "$x=\\dfrac{\\pi}{6},\\ \\dfrac{5\\pi}{6}$", "correct": true}, {"key": "b", "text": "$x=\\dfrac{\\pi}{6}$", "correct": false, "mis": "INC_TRIG_ONE_SOLUTION"}, {"key": "c", "text": "$x=\\dfrac{\\pi}{6},\\ \\dfrac{7\\pi}{6}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "d", "text": "$x=\\dfrac{\\pi}{3},\\ \\dfrac{2\\pi}{3}$", "correct": false, "mis": "TRIG_COORD_SWAP"}], "source": "hand"}, {"id": "trig_equations-02", "kc": "trig_equations", "difficulty": 3, "est_seconds": 60, "stem": "Solve $2\\cos x+1=0$ on $[0,2\\pi)$.", "hint": "Isolate the cosine first; a negative value puts you in two specific quadrants.", "worked": ["$\\cos x=-\\dfrac{1}{2}$", "Reference angle $\\dfrac{\\pi}{3}$", "Cosine is negative in Quadrants II and III", "$x=\\dfrac{2\\pi}{3},\\ \\dfrac{4\\pi}{3}$"], "options": [{"key": "a", "text": "$x=\\dfrac{2\\pi}{3},\\ \\dfrac{4\\pi}{3}$", "correct": true}, {"key": "b", "text": "$x=\\dfrac{2\\pi}{3}$", "correct": false, "mis": "INC_TRIG_ONE_SOLUTION"}, {"key": "c", "text": "$x=\\dfrac{\\pi}{3},\\ \\dfrac{5\\pi}{3}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "d", "text": "$x=\\dfrac{\\pi}{6},\\ \\dfrac{11\\pi}{6}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_equations-03", "kc": "trig_equations", "difficulty": 5, "est_seconds": 110, "stem": "Solve $2\\sin^{2}x-\\sin x-1=0$ on $[0,2\\pi)$.", "hint": "Treat $\\sin x$ as a single unknown and factor the quadratic.", "worked": ["Factor: $(2\\sin x+1)(\\sin x-1)=0$", "$\\sin x=-\\dfrac{1}{2}$ or $\\sin x=1$", "$\\sin x=1$ gives $x=\\dfrac{\\pi}{2}$", "$\\sin x=-\\dfrac{1}{2}$ gives $x=\\dfrac{7\\pi}{6},\\ \\dfrac{11\\pi}{6}$"], "options": [{"key": "a", "text": "$x=\\dfrac{\\pi}{2},\\ \\dfrac{7\\pi}{6},\\ \\dfrac{11\\pi}{6}$", "correct": true}, {"key": "b", "text": "$x=\\dfrac{\\pi}{2}$", "correct": false, "mis": "INC_TRIG_ONE_SOLUTION"}, {"key": "c", "text": "$x=\\dfrac{7\\pi}{6},\\ \\dfrac{11\\pi}{6}$", "correct": false, "mis": "INC_ZERO_PRODUCT_MISUSE"}, {"key": "d", "text": "$x=\\dfrac{\\pi}{2},\\ \\dfrac{\\pi}{6},\\ \\dfrac{5\\pi}{6}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}], "source": "hand"}, {"id": "trig_equations-04", "kc": "trig_equations", "difficulty": 3, "est_seconds": 55, "stem": "Solve $\\tan x=1$ on $[0,2\\pi)$.", "hint": "Tangent repeats every $\\pi$, not every $2\\pi$.", "worked": ["Reference angle $\\dfrac{\\pi}{4}$", "Tangent is positive in Quadrants I and III", "$x=\\dfrac{\\pi}{4},\\ \\dfrac{5\\pi}{4}$"], "options": [{"key": "a", "text": "$x=\\dfrac{\\pi}{4},\\ \\dfrac{5\\pi}{4}$", "correct": true}, {"key": "b", "text": "$x=\\dfrac{\\pi}{4}$", "correct": false, "mis": "INC_TRIG_ONE_SOLUTION"}, {"key": "c", "text": "$x=\\dfrac{\\pi}{4},\\ \\dfrac{3\\pi}{4}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "d", "text": "$x=\\dfrac{\\pi}{4},\\ \\dfrac{7\\pi}{4}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_equations-05", "kc": "trig_equations", "difficulty": 5, "est_seconds": 100, "stem": "Solve $\\cos^{2}x=\\dfrac{1}{4}$ on $[0,2\\pi)$.", "hint": "Taking a square root to solve an equation admits both signs.", "worked": ["$\\cos x=\\pm\\dfrac{1}{2}$", "$\\cos x=\\dfrac{1}{2}$ gives $\\dfrac{\\pi}{3},\\ \\dfrac{5\\pi}{3}$", "$\\cos x=-\\dfrac{1}{2}$ gives $\\dfrac{2\\pi}{3},\\ \\dfrac{4\\pi}{3}$"], "options": [{"key": "a", "text": "$x=\\dfrac{\\pi}{3},\\ \\dfrac{2\\pi}{3},\\ \\dfrac{4\\pi}{3},\\ \\dfrac{5\\pi}{3}$", "correct": true}, {"key": "b", "text": "$x=\\dfrac{\\pi}{3},\\ \\dfrac{5\\pi}{3}$", "correct": false, "mis": "I