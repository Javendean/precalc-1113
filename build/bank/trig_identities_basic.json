{"kc": "trig_identities_basic", "items": [{"id": "trig_identities_basic-01", "kc": "trig_identities_basic", "difficulty": 2, "est_seconds": 40, "stem": "Simplify $1-\\cos^{2}\\theta$.", "hint": "Rearrange $\\sin^{2}\\theta+\\cos^{2}\\theta=1$.", "worked": ["$\\sin^{2}\\theta+\\cos^{2}\\theta=1$", "$\\sin^{2}\\theta=1-\\cos^{2}\\theta$"], "options": [{"key": "a", "text": "$\\sin^{2}\\theta$", "correct": true}, {"key": "b", "text": "$\\sin\\theta$", "correct": false, "mis": "NOT_TRIG_SQUARED"}, {"key": "c", "text": "$-\\sin^{2}\\theta$", "correct": false, "mis": "TRIG_PYTHAG_REARRANGE"}, {"key": "d", "text": "$\\cos^{2}\\theta-1$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}], "source": "hand"}, {"id": "trig_identities_basic-02", "kc": "trig_identities_basic", "difficulty": 4, "est_seconds": 70, "stem": "If $\\sin\\theta=\\dfrac{3}{5}$ and $\\theta$ lies in Quadrant II, find $\\cos\\theta$.", "hint": "Find the size first, then fix the sign using the quadrant.", "worked": ["$\\cos^{2}\\theta=1-\\dfrac{9}{25}=\\dfrac{16}{25}$", "$|\\cos\\theta|=\\dfrac{4}{5}$", "Cosine is negative in Quadrant II, so $\\cos\\theta=-\\dfrac{4}{5}$"], "options": [{"key": "a", "text": "$-\\dfrac{4}{5}$", "correct": true}, {"key": "b", "text": "$\\dfrac{4}{5}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "c", "text": "$\\dfrac{16}{25}$", "correct": false, "mis": "NOT_TRIG_SQUARED"}, {"key": "d", "text": "$-\\dfrac{3}{4}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}, {"id": "trig_identities_basic-03", "kc": "trig_identities_basic", "difficulty": 2, "est_seconds": 35, "stem": "Which expression equals $\\sec\\theta$?", "hint": "Secant is the reciprocal of one of the two basic ratios. Which one?", "worked": ["$\\sec\\theta=\\dfrac{1}{\\cos\\theta}$ by definition"], "options": [{"key": "a", "text": "$\\dfrac{1}{\\cos\\theta}$", "correct": true}, {"key": "b", "text": "$\\dfrac{1}{\\sin\\theta}$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$\\arccos\\theta$", "correct": false, "mis": "INV_TRIG_RECIPROCAL"}, {"key": "d", "text": "$\\dfrac{\\sin\\theta}{\\cos\\theta}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_identities_basic-04", "kc": "trig_identities_basic", "difficulty": 3, "est_seconds": 50, "stem": "Exactly one of these is an identity. Which one?", "hint": "Divide $\\sin^{2}\\theta+\\cos^{2}\\theta=1$ through by $\\cos^{2}\\theta$.", "worked": ["Divide by $\\cos^{2}\\theta$: $\\tan^{2}\\theta+1=\\sec^{2}\\theta$"], "options": [{"key": "a", "text": "$1+\\tan^{2}\\theta=\\sec^{2}\\theta$", "correct": true}, {"key": "b", "text": "$1+\\cot^{2}\\theta=\\sec^{2}\\theta$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$1-\\tan^{2}\\theta=\\sec^{2}\\theta$", "correct": false, "mis": "TRIG_PYTHAG_REARRANGE"}, {"key": "d", "text": "$\\tan^{2}\\theta-1=\\sec^{2}\\theta$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}], "source": "hand"}, {"id": "trig_identities_basic-05", "kc": "trig_identities_basic", "difficulty": 4, "est_seconds": 65, "stem": "If $\\cos\\theta=\\dfrac{\\sqrt{3}}{2}$ and $\\theta$ lies in Quadrant IV, find $\\sin\\theta$.", "hint": "Sine is negative below the horizontal axis.", "worked": ["$\\sin^{2}\\theta=1-\\dfrac{3}{4}=\\dfrac{1}{4}$", "$|\\sin\\theta|=\\dfrac{1}{2}$; Quadrant IV makes it negative"], "options": [{"key": "a", "text": "$-\\dfrac{1}{2}$", "correct": true}, {"key": "b", "text": "$\\dfrac{1}{2}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "c", "text": "$-\\dfrac{\\sqrt{3}}{2}$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "d", "text": "$\\dfrac{1}{4}$", "correct": false, "mis": "NOT_TRIG_SQUARED"}], "source": "hand"}]}