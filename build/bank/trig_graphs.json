{"kc": "trig_graphs", "items": [{"id": "trig_graphs-01", "kc": "trig_graphs", "difficulty": 2, "est_seconds": 35, "stem": "What is the period of $y=\\sin(3x)$?", "hint": "A larger coefficient on $x$ makes the wave finish faster, not slower.", "worked": ["Period $=\\dfrac{2\\pi}{b}$ with $b=3$", "$=\\dfrac{2\\pi}{3}$"], "options": [{"key": "a", "text": "$\\dfrac{2\\pi}{3}$", "correct": true}, {"key": "b", "text": "$6\\pi$", "correct": false, "mis": "DIR_PERIOD_MULTIPLIED"}, {"key": "c", "text": "$\\dfrac{\\pi}{3}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$3$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_graphs-02", "kc": "trig_graphs", "difficulty": 3, "est_seconds": 50, "stem": "Give the amplitude and period of $y=-4\\cos(2x)$.", "hint": "Amplitude is a size, so it cannot be negative.", "worked": ["Amplitude $=|-4|=4$", "Period $=\\dfrac{2\\pi}{2}=\\pi$"], "options": [{"key": "a", "text": "amplitude $4$, period $\\pi$", "correct": true}, {"key": "b", "text": "amplitude $-4$, period $\\pi$", "correct": false, "mis": null}, {"key": "c", "text": "amplitude $4$, period $4\\pi$", "correct": false, "mis": "DIR_PERIOD_MULTIPLIED"}, {"key": "d", "text": "amplitude $2$, period $\\pi$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}, {"id": "trig_graphs-03", "kc": "trig_graphs", "difficulty": 4, "est_seconds": 65, "stem": "Find the phase shift of $y=\\sin(2x-\\pi)$.", "hint": "Factor the coefficient out of the whole inside before reading anything off.", "worked": ["$2x-\\pi=2\\left(x-\\dfrac{\\pi}{2}\\right)$", "So the shift is $\\dfrac{\\pi}{2}$ to the right"], "options": [{"key": "a", "text": "$\\dfrac{\\pi}{2}$ to the right", "correct": true}, {"key": "b", "text": "$\\pi$ to the right", "correct": false, "mis": "DIR_TRANSFORM_ORDER"}, {"key": "c", "text": "$\\dfrac{\\pi}{2}$ to the left", "correct": false, "mis": "DIR_SHIFT_BACKWARDS"}, {"key": "d", "text": "$2\\pi$ to the right", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_graphs-04", "kc": "trig_graphs", "difficulty": 3, "est_seconds": 55, "stem": "What is the range of $y=3\\sin(x)+5$?", "hint": "The $3$ stretches the wave; the $5$ lifts the whole thing.", "worked": ["$\\sin x$ runs from $-1$ to $1$", "$3\\sin x$ runs from $-3$ to $3$", "Adding $5$ gives $2$ to $8$"], "options": [{"key": "a", "text": "$[2,8]$", "correct": true}, {"key": "b", "text": "$[-3,3]$", "correct": false, "mis": "DIR_INSIDE_OUTSIDE"}, {"key": "c", "text": "$[5,8]$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$[0,8]$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_graphs-05", "kc": "trig_graphs", "difficulty": 2, "est_seconds": 40, "stem": "How does the graph of $y=\\cos\\left(x+\\dfrac{\\pi}{3}\\right)$ compare with $y=\\cos x$?", "hint": "Ask which input now produces the value that used to happen at $x=0$.", "worked": ["The inside is zero when $x=-\\dfrac{\\pi}{3}$", "So the graph slides $\\dfrac{\\pi}{3}$ to the left"], "options": [{"key": "a", "text": "shifted $\\dfrac{\\pi}{3}$ to the left", "correct": true}, {"key": "b", "text": "shifted $\\dfrac{\\pi}{3}$ to the right", "correct": false, "mis": "DIR_SHIFT_BACKWARDS"}, {"key": "c", "text": "shifted $\\dfrac{\\pi}{3}$ upward", "correct": false, "mis": "DIR_INSIDE_OUTSIDE"}, {"key": "d", "text": "its period becomes $\\dfrac{\\pi}{3}$", "correct": false, "mis": null}], "source": "hand"}]}