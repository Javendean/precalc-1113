{"kc": "trig_simplify", "items": [{"id": "trig_simplify-01", "kc": "trig_simplify", "difficulty": 4, "est_seconds": 75, "stem": "Simplify $\\dfrac{\\sin^{2}\\theta}{1-\\cos\\theta}$.", "hint": "Rewrite the numerator using the Pythagorean identity, then factor.", "worked": ["$\\sin^{2}\\theta=1-\\cos^{2}\\theta=(1-\\cos\\theta)(1+\\cos\\theta)$", "Cancel the common FACTOR $(1-\\cos\\theta)$", "$=1+\\cos\\theta$"], "options": [{"key": "a", "text": "$1+\\cos\\theta$", "correct": true}, {"key": "b", "text": "$\\sin\\theta$", "correct": false, "mis": "NOT_TRIG_SQUARED"}, {"key": "c", "text": "$1-\\cos\\theta$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "$\\dfrac{\\sin^{2}\\theta}{-\\cos\\theta}$", "correct": false, "mis": "DOM_CANCEL_ADDEND"}], "source": "hand"}, {"id": "trig_simplify-02", "kc": "trig_simplify", "difficulty": 3, "est_seconds": 50, "stem": "Simplify $\\cos\\theta\\tan\\theta$.", "hint": "Write tangent as a ratio and cancel.", "worked": ["$\\cos\\theta\\cdot\\dfrac{\\sin\\theta}{\\cos\\theta}$", "$=\\sin\\theta$"], "options": [{"key": "a", "text": "$\\sin\\theta$", "correct": true}, {"key": "b", "text": "$\\dfrac{\\cos^{2}\\theta}{\\sin\\theta}$", "correct": false, "mis": "TRIG_COORD_SWAP"}, {"key": "c", "text": "$\\sec\\theta$", "correct": false, "mis": "INV_TRIG_RECIPROCAL"}, {"key": "d", "text": "$1$", "correct": false, "mis": null}], "source": "hand"}, {"id": "trig_simplify-03", "kc": "trig_simplify", "difficulty": 3, "est_seconds": 45, "stem": "Simplify $\\sec^{2}\\theta-\\tan^{2}\\theta$.", "hint": "Use the identity that relates secant and tangent.", "worked": ["$1+\\tan^{2}\\theta=\\sec^{2}\\theta$", "So $\\sec^{2}\\theta-\\tan^{2}\\theta=1$"], "options": [{"key": "a", "text": "$1$", "correct": true}, {"key": "b", "text": "$\\sec\\theta-\\tan\\theta$", "correct": false, "mis": "NOT_TRIG_SQUARED"}, {"key": "c", "text": "$-1$", "correct": false, "mis": "TRIG_PYTHAG_REARRANGE"}, {"key": "d", "text": "$\\tan^{2}\\theta$", "corre