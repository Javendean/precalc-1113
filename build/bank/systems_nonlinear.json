{"kc": "systems_nonlinear", "items": [{"id": "systems_nonlinear-01", "kc": "systems_nonlinear", "difficulty": 4, "est_seconds": 80, "stem": "Solve the system $y=x^{2}$ and $y=x+2$.", "hint": "Set the two expressions for $y$ equal, then find BOTH points.", "worked": ["$x^{2}=x+2$", "$x^{2}-x-2=0$", "$(x-2)(x+1)=0$, so $x=2$ or $x=-1$", "Points: $(2,4)$ and $(-1,1)$"], "options": [{"key": "a", "text": "$(2,4)$ and $(-1,1)$", "correct": true}, {"key": "b", "text": "$(2,4)$ only", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "c", "text": "$(2,4)$ and $(1,-1)$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "no solution", "correct": false, "mis": null}], "source": "hand"}, {"id": "systems_nonlinear-02", "kc": "systems_nonlinear", "difficulty": 2, "est_seconds": 40, "stem": "How many times can a straight line cross a circle?", "hint": "Picture sliding a ruler across a coin.", "worked": ["It can miss, touch once as a tangent, or cut through twice"], "options": [{"key": "a", "text": "$0$, $1$, or $2$ times", "correct": true}, {"key": "b", "text": "exactly $2$ times", "correct": false, "mis": null}, {"key": "c", "text": "$0$ or $2$ times", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "d", "text": "up to $4$ times", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}, {"id": "systems_nonlinear-03", "kc": "systems_nonlinear", "difficulty": 5, "est_seconds": 110, "stem": "Solve the system $x^{2}+y^{2}=25$ and $y=x+1$.", "hint": "Substitute the line into the circle and expand carefully.", "worked": ["$x^{2}+(x+1)^{2}=25$", "$2x^{2}+2x+1=25$", "$x^{2}+x-12=0$", "$(x+4)(x-3)=0$, so $x=-4$ or $x=3$", "Points: $(3,4)$ and $(-4,-3)$"], "options": [{"key": "a", "text": "$(3,4)$ and $(-4,-3)$", "correct": true}, {"key": "b", "text": "$(3,4)$ only", "correct": false, "mis": "SYS_PARTIAL_SOLUTION"}, {"key": "c", "text": "$(3,-4)$ and $(-4,3)$", "correct": false, "mis": "SIGN_DISTRIB_NEG"}, {"key": "d", "text": "$(5,0)$ and $(-5,0)$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}], "source": "hand"}]}