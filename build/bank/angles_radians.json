{"kc": "angles_radians", "items": [{"id": "angles_radians-01", "kc": "angles_radians", "difficulty": 1, "est_seconds": 35, "stem": "Convert $135^\\circ$ to radians.", "hint": "Multiply by $\\dfrac{\\pi}{180}$, then reduce the fraction.", "worked": ["$135\\cdot\\dfrac{\\pi}{180}$", "$\\dfrac{135}{180}=\\dfrac{3}{4}$", "$\\dfrac{3\\pi}{4}$"], "options": [{"key": "a", "text": "$\\dfrac{3\\pi}{4}$", "correct": true}, {"key": "b", "text": "$\\dfrac{4\\pi}{3}$", "correct": false, "mis": "TRIG_CONVERSION_INVERTED"}, {"key": "c", "text": "$135\\pi$", "correct": false, "mis": "TRIG_DEGREE_RADIAN_MODE"}, {"key": "d", "text": "$\\dfrac{3\\pi}{2}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "angles_radians-02", "kc": "angles_radians", "difficulty": 2, "est_seconds": 40, "stem": "Convert $\\dfrac{5\\pi}{6}$ radians to degrees.", "hint": "Multiply by $\\dfrac{180}{\\pi}$ so the $\\pi$ cancels.", "worked": ["$\\dfrac{5\\pi}{6}\\cdot\\dfrac{180}{\\pi}$", "$=5\\cdot 30=150$"], "options": [{"key": "a", "text": "$150^\\circ$", "correct": true}, {"key": "b", "text": "$216^\\circ$", "correct": false, "mis": "TRIG_CONVERSION_INVERTED"}, {"key": "c", "text": "$150\\pi^\\circ$", "correct": false, "mis": "TRIG_DEGREE_RADIAN_MODE"}, {"key": "d", "text": "$30^\\circ$", "correct": false, "mis": null}], "source": "hand"}, {"id": "angles_radians-03", "kc": "angles_radians", "difficulty": 3, "est_seconds": 55, "stem": "A circle has radius $9$. Find the length of the arc cut off by a central angle of $\\dfrac{2\\pi}{3}$ radians.", "hint": "Arc length is $s=r\\theta$, and $\\theta$ must already be in radians.", "worked": ["$s=r\\theta=9\\cdot\\dfrac{2\\pi}{3}$", "$=6\\pi$"], "options": [{"key": "a", "text": "$6\\pi$", "correct": true}, {"key": "b", "text": "$54\\pi$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$1080$", "correct": false, "mis": "TRIG_DEGREE_RADIAN_MODE"}, {"key": "d", "text": "$\\dfrac{2\\pi}{27}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "angles_radians-04", "kc": "angles_radians", "difficulty": 3, "est_seconds": 45, "stem": "Which angle is coterminal with $\\dfrac{\\pi}{4}$?", "hint": "Coterminal angles differ by a whole turn.", "worked": ["A whole turn is $2\\pi$", "$\\dfrac{\\pi}{4}+2\\pi=\\dfrac{\\pi}{4}+\\dfrac{8\\pi}{4}=\\dfrac{9\\pi}{4}$"], "options": [{"key": "a", "text": "$\\dfrac{9\\pi}{4}$", "correct": true}, {"key": "b", "text": "$\\dfrac{5\\pi}{4}$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "c", "text": "$\\dfrac{3\\pi}{4}$", "correct": false, "mis": "TRIG_QUADRANT_SIGN"}, {"key": "d", "text": "$\\dfrac{7\\pi}{4}$", "correct": false, "mis": null}], "source": "hand"}, {"id": "angles_radians-05", "kc": "angles_radians", "difficulty": 2, "est_seconds": 40, "stem": "Exactly one statement below is true. Which one?", "hint": "Half a full turn is $180^\\circ$. How many radians is that?", "worked": ["A full turn is $2\\pi$ radians and $360^\\circ$", "So half a turn: $\\pi$ radians $=180^\\circ$"], "options": [{"key": "a", "text": "$\\pi$ radians $=180^\\circ$", "correct": true}, {"key": "b", "text": "$2\\pi$ radians $=180^\\circ$", "correct": false, "mis": null}, {"key": "c", "text": "$\\pi$ radians $=360^\\circ$", "correct": false, "mis": "FORMULA_WRONG_SLOT"}, {"key": "d", "text": "$1$ radian $=\\dfrac{\\pi}{180}$ degrees", "correct": false, "mis": "TRIG_CONVERSION_INVERTED"}], "source": "hand"}]}